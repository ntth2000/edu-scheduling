@startuml
title Biểu đồ trình tự - Xuất thời khóa biểu
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Người xếp\nthời khóa biểu" as User
boundary "Giao diện\nthời khóa biểu" as UI
control "Điều khiển\nxuất dữ liệu" as Controller
control "Xử lý xuất\nExcel" as ExportService
database "CSDL\nthời khóa biểu" as DB

User -> UI: Chọn năm học, học kỳ và tuần học
User -> UI: Chọn chế độ xem và đối tượng cần xuất
User -> UI: Chọn "Xuất Excel"
UI -> Controller: xuấtExcel(tiêuChíXuất)
Controller -> ExportService: tạoTệpExcel(tiêuChíXuất)
ExportService -> DB: truyVấnDữLiệuTheoTiêuChí()
DB --> ExportService: Dữ liệu thời khóa biểu
ExportService -> ExportService: tổngHợpTheoChếĐộXem()
ExportService -> ExportService: tạoTệpXlsx()
ExportService --> Controller: Tệp Excel
Controller --> UI: Trả về tệp .xlsx
UI --> User: Tải tệp xuống trình duyệt
@enduml
