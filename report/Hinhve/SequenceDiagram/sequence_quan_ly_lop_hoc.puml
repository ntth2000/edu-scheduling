@startuml
title Biểu đồ trình tự - Quản lý lớp học
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Người xếp\nthời khóa biểu" as User
boundary "Giao diện quản lý\nlớp học" as UI
control "Điều khiển\nlớp học" as Controller
control "Xử lý nghiệp vụ\nlớp học" as Service
database "CSDL\nlớp học" as DB

User -> UI: Chọn năm học và mở chức năng quản lý lớp
UI -> Controller: lấyDanhSáchLớp(mãNămHọc)
Controller -> Service: lấyDanhSáchLớp(mãNămHọc)
Service -> DB: truyVấnLớpTheoNămHọc()
DB --> Service: Danh sách lớp
Service --> Controller: Danh sách lớp
Controller --> UI: Trả về danh sách
UI --> User: Hiển thị danh sách lớp

alt Thêm mới hoặc cập nhật lớp
    User -> UI: Nhập tên lớp, khối và xác nhận
    UI -> Controller: lưuLớp(thôngTinLớp)
    Controller -> Controller: kiểmTraTênTrùngVàKhối()
    alt Tên lớp bị trùng hoặc khối không hợp lệ
        Controller --> UI: Trả về thông báo lỗi
        UI --> User: Hiển thị lỗi, không lưu thay đổi
    else Dữ liệu hợp lệ
        Controller -> Service: lưuLớp(thôngTinLớp)
        Service -> DB: thêmHoặcCậpNhậtLớp()
        DB --> Service: Lưu thành công
        Service --> Controller: Lớp đã cập nhật
        Controller --> UI: Trả về kết quả
        UI --> User: Cập nhật danh sách lớp
    end
else Xóa lớp học
    User -> UI: Chọn lớp và yêu cầu xóa
    UI -> Controller: xóaLớp(mãLớp)
    Controller -> Service: xóaLớp(mãLớp)
    Service -> DB: thựcHiệnXóa()
    DB --> Service: Xóa thành công
    Service --> Controller: Kết quả xóa
    Controller --> UI: Trả về kết quả
    UI --> User: Cập nhật danh sách lớp
end
@enduml
